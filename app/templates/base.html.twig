{# templates/base.html.twig #}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        {% block title %}
            Sistema RR.HH
        {% endblock %}
    </title>


    {# =========================
       ROBOTO
    ========================== #}

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    >


    {# =========================
       STYLESHEETS
    ========================== #}

    {% block stylesheets %}

        <link
            rel="stylesheet"
            href="{{ asset('css/base.css') }}"
        >

    {% endblock %}


    {% block javascripts %}
    {% endblock %}

</head>


<body>

<div class="app">


    {# =========================
       SIDEBAR
    ========================== #}

    <aside class="sidebar">

        <div class="sidebar-header">

            <h1>
                Sistema RR.HH
            </h1>

            <span>
                Panel de administración
            </span>

        </div>


        <nav class="navigation">

            <div class="navigation-title">
                Principal
            </div>


            {# Dashboard #}

            <a
                href="{{ path('dashboard_index') }}"
                class="{{ app.request.attributes.get('_route') == 'dashboard_index' ? 'active' : '' }}"
            >
                Dashboard
            </a>


            {# Empleados #}

            <a
                href="{{ path('employees_index') }}"
                class="{{ app.request.attributes.get('_route') starts with 'employees_' ? 'active' : '' }}"
            >
                Empleados
            </a>


            {# Departamentos #}

            <a
                href="{{ path('departments_index') }}"
                class="{{ app.request.attributes.get('_route') starts with 'departments_' ? 'active' : '' }}"
            >
                Departamentos
            </a>


            {# Asistencias #}

            <a
                href="{{ path('attendance_records_index') }}"
                class="{{ app.request.attributes.get('_route') starts with 'attendance_records_' ? 'active' : '' }}"
            >
                Registro de Asistencias
            </a>


            <div
                class="navigation-title"
                style="margin-top: 25px;"
            >
                Sistema
            </div>


            {# Configuración #}

            <a
                href="{{ path('settings_index') }}"
                class="{{ app.request.attributes.get('_route') starts with 'settings_' ? 'active' : '' }}"
            >
                Configuración
            </a>

        </nav>


        <div class="sidebar-footer">

            Sistema RR.HH

        </div>

    </aside>


    {# =========================
       MAIN
    ========================== #}

    <div class="main">

        <header class="topbar">

            <h2>

                {% block page_title %}
                    Dashboard
                {% endblock %}

            </h2>

        </header>


        <main class="content">

            {% block body %}
            {% endblock %}

        </main>

    </div>

</div>

</body>

</html>