{# templates/departments/index.html.twig #}

{% extends 'base.html.twig' %}

{% set title_name = 'Departamentos' %}
{% block title %}
    {{ title_name }}
{% endblock %}
{% block page_title %}
    {{ title_name }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/crud.css') }}">
{% endblock %}

{% block body %}
    <div class="page-header">
        <div class="page-header-content">
            <h1>{{ title_name }}</h1>
            <p>Administra los departamentos registrados en el sistema.</p>
        </div>
        <a href="#"class="btn btn-primary">+ Crear departamento</a>
    </div>

    <div class="table-card">
        <div class="table-header">
            <h2>Departamentos</h2>
            {% if departments is defined %}
                <span>
                    {{ departments|length }}
                    {{ departments|length == 1
                        ? 'registro'
                        : 'registros'
                    }}
                </span>
            {% endif %}
        </div>

        {% if departments is defined and departments|length > 0 %}
            <div class="table-container">
                <table class="crud-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for department in departments %}
                            <tr>
                                <td><span class="record-id">{{ department.id }}</span></td>
                                <td>{{ department.name }}</td>
                                <td>
                                    <div class="actions">
                                        <a href="#"class="action-btn action-edit">Editar</a>
                                        <a href="#"class="action-btn action-delete">Eliminar</a>
                                    </div>
                                </td>
                            </tr>

                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            {% include 'components/empty-state.html.twig' with {
                title: 'No hay departamentos registrados',
                message: 'Todavía no tienes ningún departamento registrado. Crea el primero para comenzar a organizar tu sistema.',
                action_url: '#',
                action_label: 'Crear primer departamento'
            } %}
        {% endif %}
    </div>
{% endblock %}
